# Kopieren nach .env und anpassen:   cp .env.example .env
# Secrets erzeugen:  openssl rand -hex 32

# ---- Speicherort aller Daten ----
# Hier liegen Datenbank (postgres/), Projektdateien (app/projects/), Sicherungen (app/backups/) und Logs (app/logs/).
# Relativer oder absoluter Pfad auf dem Host, z. B. /srv/uw-kabel-master. Bleibt bei Updates erhalten.
DATA_ROOT=./data

# ---- Datenbank ----
POSTGRES_DB=wtlisten
POSTGRES_USER=wtlisten
POSTGRES_PASSWORD=BITTE-AENDERN

# ---- Netzwerk ----
APP_BIND=127.0.0.1          # 0.0.0.0, wenn die App ohne Proxy direkt erreichbar sein soll
APP_PORT=8000
PROXY_HTTP_PORT=80          # nur Profil "proxy"
PROXY_HTTPS_PORT=443
BASE_URL=http://localhost:8000   # öffentliche URL (Share-Links, OIDC-Callback), z. B. https://listen.example.org
COOKIE_SECURE=false              # true, sobald die Seite über HTTPS ausgeliefert wird

# ---- Sicherheit ----
SECRET_KEY=BITTE-MIT-openssl-rand-hex-32-ERSETZEN
SESSION_HOURS=12
ADMIN_USERNAME=admin
ADMIN_PASSWORD=BITTE-AENDERN-MIN-10-ZEICHEN
ADMIN_EMAIL=
LOCAL_LOGIN_ENABLED=true
AUTO_CREATE_USERS=true           # externe Benutzer (LDAP/OIDC/OAuth2) beim ersten Login anlegen

# ---- Dateien / Share-Links ----
MAX_UPLOAD_MB=50
SHARE_DEFAULT_HOURS=72

# ---- Kalender / Auswertungen ----
TIMEZONE=Europe/Berlin            # Zeitzone für Tages-/Monatsauswertungen
CALENDAR_ALLOW_PRIVATE=false      # true: externe Kalender (ICS-Link) auch aus dem internen Netz abrufen

# ---- Logging ----
LOG_LEVEL=INFO
LOG_JSON=true
LOG_TO_FILE=true

# ---- OpenID Connect (Keycloak, Authentik, Entra ID, Google, ...) ----
# Redirect-URI beim Anbieter eintragen:  ${BASE_URL}/api/auth/oidc/callback
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_NAME=Single Sign-On
OIDC_SCOPES=openid profile email
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUP=

# ---- Generisches OAuth2 (z. B. GitHub / Gitea) ----
# Redirect-URI beim Anbieter eintragen:  ${BASE_URL}/api/auth/oauth2/callback
OAUTH2_NAME=GitHub
OAUTH2_AUTHORIZE_URL=
OAUTH2_TOKEN_URL=
OAUTH2_USERINFO_URL=
OAUTH2_CLIENT_ID=
OAUTH2_CLIENT_SECRET=
OAUTH2_SCOPES=read:user user:email
OAUTH2_ID_FIELD=id
OAUTH2_USERNAME_FIELD=login
OAUTH2_EMAIL_FIELD=email
OAUTH2_NAME_FIELD=name

# ---- Sicherungen (Verwaltung -> Sicherungen) ----
# Täglich automatisch ab BACKUP_TIME (Serverzeit); der Zeitplan läuft im Server, daher WEB_CONCURRENCY=1 lassen.
BACKUP_ENABLED=true
BACKUP_TIME=02:00
# So viele automatische Sicherungen werden behalten:
BACKUP_KEEP=14
# Excel-Dateien aus den Projektordnern mitsichern (größere Sicherungen):
BACKUP_INCLUDE_FILES=false

# ---- LDAP / Active Directory ----
LDAP_SERVER_URI=
LDAP_START_TLS=false
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_BASE=
LDAP_USER_FILTER=(uid={username})
LDAP_ATTR_USERNAME=uid
LDAP_ATTR_EMAIL=mail
LDAP_ATTR_NAME=cn
LDAP_ADMIN_GROUP_DN=
